#!/usr/bin/env python3
"""
Codex Skill: Delete Dead Code

Triggers the dead-code-cleanup GitHub Actions workflow to analyze the latest
RuntimeSpy instrumentation report and create a PR with dead code deletions.

Usage:
  delete-dead-code          # Trigger the workflow
"""

import subprocess
import sys


def main():
    print("🔄 Triggering GitHub Actions workflow: dead-code-cleanup.yml")
    print("")

    try:
        result = subprocess.run(
            ["gh", "workflow", "run", "dead-code-cleanup.yml"],
            capture_output=True,
            text=True,
            check=True
        )

        print("✅ Workflow triggered successfully")
        print("")
        print("The workflow will:")
        print("  1. Fetch the latest instrumentation report from RuntimeSpy backend")
        print("  2. Identify all nodes with frequency=0")
        print("  3. Create a GitHub PR with deletions")
        print("")
        print("View the workflow run:")
        print("  gh run list --workflow=dead-code-cleanup.yml --limit=1")
        print("")
        return 0

    except subprocess.CalledProcessError as e:
        print(f"❌ Error: Failed to trigger workflow", file=sys.stderr)
        if e.stderr:
            print(f"   {e.stderr}", file=sys.stderr)
        print("", file=sys.stderr)
        print("Make sure you have:", file=sys.stderr)
        print("  - Write access to the repository", file=sys.stderr)
        print("  - Valid GitHub CLI authentication (gh auth status)", file=sys.stderr)
        return 1
    except FileNotFoundError:
        print(f"❌ Error: gh CLI not found", file=sys.stderr)
        print("   Install GitHub CLI: https://cli.github.com", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
