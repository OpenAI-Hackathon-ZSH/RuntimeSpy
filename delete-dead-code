#!/usr/bin/env python3
"""
Codex Skill: Delete Dead Code

Analyzes RuntimeSpy instrumentation data and outputs JSON recommendations
for code deletions. Does not modify code directly - that's handled by
GitHub Actions.

Usage:
  delete-dead-code [OPTIONS] [INPUT_FILE]
  delete-dead-code --limit 5 instrumentation.json > recommendations.json
  delete-dead-code --limit 3 report.json --output recommendations.json
"""

import argparse
import json
import sys
from pathlib import Path
from collections import defaultdict


def parse_args():
    parser = argparse.ArgumentParser(
        description="Analyze dead code and output deletion recommendations",
        prog="delete-dead-code"
    )
    parser.add_argument(
        "input_file",
        nargs="?",
        help="Instrumentation JSON file (or stdin if omitted)"
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=3,
        help="Maximum number of groups (default: 3)"
    )
    parser.add_argument(
        "--output",
        help="Write to file instead of stdout"
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Show analysis details"
    )
    return parser.parse_args()


def read_instrumentation(input_file):
    """Read instrumentation JSON from file or stdin."""
    try:
        if input_file:
            with open(input_file) as f:
                return json.load(f)
        else:
            return json.load(sys.stdin)
    except FileNotFoundError as e:
        print(f"❌ Error: File not found: {e}", file=sys.stderr)
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"❌ Error: Invalid JSON: {e}", file=sys.stderr)
        sys.exit(1)


def extract_dead_nodes(data):
    """Extract nodes with frequency=0 grouped by file."""
    nodes = data.get("graph", {}).get("nodes", [])
    dead_by_file = defaultdict(list)

    for node in nodes:
        if node.get("frequency", 0) == 0:
            file_path = node.get("path", "unknown")
            dead_by_file[file_path].append(node)

    return dead_by_file


def group_deletions(dead_by_file, limit):
    """Group dead code by file and create deletion recommendations."""
    groups = []

    for file_path in sorted(dead_by_file.keys())[:limit]:
        nodes = dead_by_file[file_path]
        if not nodes:
            continue

        # Sort by line number
        nodes.sort(key=lambda n: n.get("start_line", 0))

        # Merge adjacent/overlapping deletions
        deletions = []
        current_start = None
        current_end = None

        for node in nodes:
            start = node.get("start_line", 0)
            end = node.get("end_line", 0)

            if current_start is None:
                current_start = start
                current_end = end
            elif start <= current_end + 1:
                # Merge with previous
                current_end = max(current_end, end)
            else:
                # Save previous deletion
                deletions.append({
                    "start_line": current_start,
                    "end_line": current_end
                })
                current_start = start
                current_end = end

        # Add last deletion
        if current_start is not None:
            deletions.append({
                "start_line": current_start,
                "end_line": current_end
            })

        group = {
            "file": file_path,
            "dead_nodes": len(nodes),
            "deletions": deletions,
            "total_lines": sum(d["end_line"] - d["start_line"] + 1 for d in deletions),
            "confidence": 95,  # Default confidence for frequency=0
            "risk": 2  # Default low risk (dead code)
        }
        groups.append(group)

    return groups


def main():
    args = parse_args()

    # Read instrumentation
    if args.verbose:
        print("📊 Reading instrumentation data...", file=sys.stderr)
    data = read_instrumentation(args.input_file)

    # Extract dead code
    summary = data.get("summary", {})
    dead_by_file = extract_dead_nodes(data)
    total_dead = sum(len(nodes) for nodes in dead_by_file.values())

    if args.verbose:
        print(f"✓ Found {total_dead} dead nodes across {len(dead_by_file)} files", file=sys.stderr)

    if total_dead == 0:
        result = {
            "status": "success",
            "message": "No dead code found",
            "groups": []
        }
    else:
        # Group deletions
        groups = group_deletions(dead_by_file, args.limit)

        result = {
            "status": "success",
            "message": f"Analyzed {total_dead} dead nodes, created {len(groups)} groups",
            "summary": {
                "total_nodes": summary.get("nodes", 0),
                "executed_nodes": summary.get("executed_nodes", 0),
                "dead_nodes": total_dead,
                "files_affected": len(dead_by_file)
            },
            "groups": groups
        }

    # Output JSON
    output = json.dumps(result, indent=2)

    if args.output:
        with open(args.output, "w") as f:
            f.write(output)
        if args.verbose:
            print(f"✓ Recommendations written to {args.output}", file=sys.stderr)
    else:
        print(output)

    return 0


if __name__ == "__main__":
    sys.exit(main())
